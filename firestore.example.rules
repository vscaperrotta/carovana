// Template for firestore.rules — copy this file to firestore.rules (gitignored,
// deployed per Firebase project) and run:
//   firebase deploy --only firestore:rules --project <your-project-id>
rules_version = '2';

// Carovana has no auth by design: whoever has the trip link can read and
// write everything in that trip. This is intentionally open, not locked
// down per-user — do not put anything sensitive in a trip.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow read, write: if true;

      match /people/{personId} {
        allow read, write: if true;
      }

      match /places/{placeId} {
        allow read, write: if true;
      }

      match /routes/{routeId} {
        allow read, write: if true;
      }
    }
  }
}
